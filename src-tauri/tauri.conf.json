{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraAudio",
  "version": "0.1.0",
  "identifier": "com.auraaudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AuraAudio",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "**/*",
          "*/**",
          "C:/**",
          "D:/**",
          "E:/**",
          "F:/**",
          "G:/**",
          "H:/**",
          "I:/**",
          "J:/**"
        ]
      },
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https: data: http://asset.localhost https://asset.localhost; media-src 'self' asset: https: data: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCNDY0RjFBRTcxNkZCODEKUldTQit4Ym5HazlHZXh1b1dzRm1nTTZlc0IyTEYvLzVlQU5UR0dYbElESjhYSEQvaUhKaHdLSzYK",
      "endpoints": [
        "https://github.com/freddy777-01/AuraAudioBookReader/releases/latest/download/latest.json"
      ]
    }
  }
}
